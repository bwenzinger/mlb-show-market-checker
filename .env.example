# Backend: bind publicly when hosting the full app from a Linux machine.
MARKET_SERVER_HOST=0.0.0.0
MARKET_SERVER_PORT=4000
MARKET_DB_PATH=./market.sqlite

# Optional. Use a comma-separated list when the frontend is on another origin.
# If the backend serves the frontend too, "*" is fine.
CORS_ORIGINS=*

# Collector tuning.
COLLECTOR_INTERVAL_MS=3600000
COLLECTOR_CONCURRENCY=4
REQUEST_DELAY_MS=150

# The Show API base.
SHOW_API_BASE_URL=https://mlb26.theshow.com/apis

# Frontend only. Leave unset when this backend serves the React build.
# Set this only if the frontend is hosted somewhere else, like Vercel.
# VITE_BACKEND_API_BASE=https://your-domain.example
